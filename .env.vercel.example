# -- Database (use Neon serverless Postgres -- copy the pooled connection string) --
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# -- Security --
SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(32))">
ENVIRONMENT=production

# -- Stripe --
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -- Admin --
ADMIN_API_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(16))">

# -- Email (SMTP) --
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_...

# -- Shipping --
FREE_SHIPPING_THRESHOLD_PENCE=4000
SHIPPING_FLAT_PENCE=299

# -- Frontend (leave blank -- frontend and API share the same Vercel domain) --
FRONTEND_URL=

# -- Vite (build-time, set in Vercel project -> Settings -> Environment Variables) --
VITE_STRIPE_PUBLIC_KEY=pk_live_...
VITE_API_BASE_URL=/api/v1
VITE_WA_NUMBER=447XXXXXXXXX
