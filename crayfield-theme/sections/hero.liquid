{% comment %} ── Crayfield Hero Section ── {% endcomment %}

<section class="cr-hero cr-section" aria-label="Hero">
  <div class="cr-container cr-hero__inner">

    <div class="cr-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="cr-section__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1 class="cr-hero__heading">{{ section.settings.heading }}</h1>
      <p class="cr-hero__subheading">{{ section.settings.subheading }}</p>

      <div class="cr-trust-row cr-hero__trust">
        {% for i in (1..3) %}
          {% assign trust_key = 'trust_' | append: i %}
          {% assign trust_val = section.settings[trust_key] %}
          {% if trust_val != blank %}
            <span class="cr-trust-item">{{ trust_val }}</span>
          {% endif %}
        {% endfor %}
      </div>

      <div class="cr-hero__ctas">
        <a href="{{ section.settings.cta_primary_url }}" class="cr-btn cr-btn--primary">
          {{ section.settings.cta_primary_label }}
        </a>
        <a href="{{ section.settings.cta_secondary_url }}" class="cr-btn cr-btn--outline">
          {{ section.settings.cta_secondary_label }}
        </a>
      </div>

      <div class="cr-hero__reassurance">
        {% if section.settings.delivery_promise != blank %}
          <p class="cr-hero__delivery">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/><circle cx="10" cy="20" r="1"/><circle cx="20" cy="20" r="1"/></svg>
            {{ section.settings.delivery_promise }}
          </p>
        {% endif %}
        <div class="cr-hero__payments">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'cr-hero__pay-icon' }}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="cr-hero__image">
      {% if section.settings.image %}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          srcset="{{ section.settings.image | image_url: width: 480 }} 480w,
                  {{ section.settings.image | image_url: width: 900 }} 900w"
          sizes="(min-width: 900px) 50vw, 100vw"
          alt="{{ section.settings.image.alt | default: 'Crayfield premium crayfish' }}"
          width="900"
          height="{{ 900 | divided_by: section.settings.image.aspect_ratio | round }}"
          loading="eager"
          fetchpriority="high"
        >
      {% else %}
        <div class="cr-hero__image-placeholder" aria-hidden="true">
          <span>Product image</span>
        </div>
      {% endif %}
    </div>

  </div>
</section>

{% stylesheet %}
  .cr-hero { background: var(--clr-brand-light); padding-block: clamp(3rem, 8vw, 6rem); }

  .cr-hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .cr-hero__heading {
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--clr-text);
    margin-bottom: 0.75rem;
  }

  .cr-hero__subheading {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--clr-text-muted);
    max-width: 48ch;
    margin-bottom: 1.5rem;
  }

  .cr-hero__trust { margin-bottom: 2rem; }

  .cr-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .cr-hero__reassurance {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cr-hero__delivery {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--clr-text-muted);
  }

  .cr-hero__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .cr-hero__pay-icon { height: 1.5rem; border-radius: 3px; }

  .cr-hero__image img {
    border-radius: var(--radius-lg);
    object-fit: cover;
    width: 100%;
    aspect-ratio: 4/3;
  }
  .cr-hero__image-placeholder {
    border-radius: var(--radius-lg);
    background: var(--clr-brand-muted);
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--clr-brand);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .cr-hero__inner { grid-template-columns: 1fr 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text",    "id": "eyebrow",              "label": "Eyebrow text",        "default": "Premium Nigerian Crayfish" },
    { "type": "text",    "id": "heading",               "label": "Heading",             "default": "Clean Nigerian Crayfish. Sealed. Delivered UK‑wide." },
    { "type": "text",    "id": "subheading",            "label": "Subheading",          "default": "Hand-cleaned, batch-traced, and hermetically sealed — straight from source to your kitchen." },
    { "type": "text",    "id": "trust_1",               "label": "Trust bullet 1",      "default": "Cleaned & sorted" },
    { "type": "text",    "id": "trust_2",               "label": "Trust bullet 2",      "default": "Sealed freshness" },
    { "type": "text",    "id": "trust_3",               "label": "Trust bullet 3",      "default": "Wholesale available" },
    { "type": "text",    "id": "cta_primary_label",     "label": "Primary CTA label",   "default": "Shop now" },
    { "type": "url",     "id": "cta_primary_url",       "label": "Primary CTA URL" },
    { "type": "text",    "id": "cta_secondary_label",   "label": "Secondary CTA label", "default": "Wholesale enquiry" },
    { "type": "url",     "id": "cta_secondary_url",     "label": "Secondary CTA URL" },
    { "type": "text",    "id": "delivery_promise",      "label": "Delivery promise",    "default": "Orders placed before 12pm dispatched same day" },
    { "type": "image_picker", "id": "image",            "label": "Hero image" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
