{% comment %} ── Crayfield Recipe Cards + Email/WhatsApp Signup Section ── {% endcomment %}

<section class="cr-section cr-section--alt cr-recipes" aria-label="Recipes and newsletter signup">
  <div class="cr-container">

    <div class="cr-recipes__header">
      <p class="cr-section__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="cr-section__title">{{ section.settings.title }}</h2>
      <p class="cr-section__subtitle">{{ section.settings.subtitle }}</p>
    </div>

    {% if section.blocks.size > 0 %}
      <ul class="cr-recipes__grid cr-grid-3" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'recipe' %}
            <li class="cr-card cr-recipe-card" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                <div class="cr-recipe-card__img-wrap">
                  <img
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.title }}"
                    width="600"
                    height="{{ 600 | divided_by: block.settings.image.aspect_ratio | round }}"
                    loading="lazy"
                  >
                </div>
              {% else %}
                <div class="cr-recipe-card__img-placeholder" aria-hidden="true">🦐</div>
              {% endif %}
              <div class="cr-card__body">
                <p class="cr-recipe-card__tag">{{ block.settings.tag }}</p>
                <h3 class="cr-recipe-card__title">{{ block.settings.title }}</h3>
                <p class="cr-recipe-card__desc">{{ block.settings.description }}</p>
                {% if block.settings.url != blank %}
                  <a href="{{ block.settings.url }}" class="cr-recipe-card__link" aria-label="Read recipe: {{ block.settings.title }}">
                    Read recipe →
                  </a>
                {% endif %}
              </div>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}

    {%- comment -%} Email + WhatsApp Signup strip {%- endcomment -%}
    <div class="cr-recipes__signup">
      <div class="cr-recipes__signup-text">
        <h3>{{ section.settings.signup_title }}</h3>
        <p>{{ section.settings.signup_subtitle }}</p>
      </div>

      <div class="cr-recipes__signup-actions">
        {% form 'customer', id: 'recipe-signup-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,recipe-subscriber">
          <div class="cr-recipes__email-row">
            <label for="recipe-email" class="cr-visually-hidden">Your email address</label>
            <input
              id="recipe-email"
              type="email"
              name="contact[email]"
              placeholder="your@email.com"
              required
              autocomplete="email"
              class="cr-input"
              aria-label="Email address"
            >
            <button type="submit" class="cr-btn cr-btn--primary">Subscribe</button>
          </div>
          <p class="cr-recipes__gdpr">We'll only send recipes and offers. Unsubscribe anytime.</p>
        {% endform %}

        <span class="cr-recipes__or">or</span>

        <a
          href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ section.settings.whatsapp_prefill | url_encode }}"
          class="cr-btn cr-btn--whatsapp"
          target="_blank"
          rel="noopener"
          aria-label="Join our WhatsApp updates"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {{ section.settings.whatsapp_label }}
        </a>
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
  .cr-recipes__header { text-align: center; margin-bottom: 3rem; }
  .cr-recipes__grid { list-style: none; padding: 0; margin: 0 0 3rem; }

  .cr-recipe-card__img-wrap { overflow: hidden; }
  .cr-recipe-card__img-wrap img {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .cr-recipe-card:hover .cr-recipe-card__img-wrap img { transform: scale(1.04); }

  .cr-recipe-card__img-placeholder {
    background: var(--clr-brand-muted);
    aspect-ratio: 16/10;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
  }

  .cr-recipe-card__tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--clr-brand);
    margin-bottom: 0.25rem;
  }
  .cr-recipe-card__title { font-size: 1.05rem; font-weight: 700; margin-bottom: 0.4rem; }
  .cr-recipe-card__desc  { font-size: 0.9rem; color: var(--clr-text-muted); margin-bottom: 0.75rem; }
  .cr-recipe-card__link  { font-size: 0.9rem; font-weight: 600; color: var(--clr-brand); text-decoration: none; }
  .cr-recipe-card__link:hover { text-decoration: underline; }

  /* Signup strip */
  .cr-recipes__signup {
    background: var(--clr-white);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .cr-recipes__signup {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .cr-recipes__signup-text { flex: 0 0 40%; }
  }

  .cr-recipes__signup-text h3 { font-size: 1.3rem; font-weight: 700; margin-bottom: 0.4rem; }
  .cr-recipes__signup-text p  { font-size: 0.9rem; color: var(--clr-text-muted); }

  .cr-recipes__signup-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .cr-recipes__email-row { display: flex; gap: 0.5rem; }
  .cr-input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 2px solid var(--clr-border);
    border-radius: var(--radius-pill);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
    min-width: 0;
  }
  .cr-input:focus { border-color: var(--clr-brand); }

  .cr-recipes__gdpr { font-size: 0.75rem; color: var(--clr-text-muted); }

  .cr-recipes__or {
    text-align: center;
    font-size: 0.85rem;
    color: var(--clr-text-muted);
    font-weight: 600;
  }

  .cr-visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recipes & Signup",
  "settings": [
    { "type": "text", "id": "eyebrow",          "label": "Eyebrow",            "default": "Inspiration" },
    { "type": "text", "id": "title",             "label": "Title",              "default": "Recipe Ideas with Crayfield Crayfish" },
    { "type": "text", "id": "subtitle",          "label": "Subtitle",           "default": "From everyday soups to party jollof — see how our crayfish transforms every dish." },
    { "type": "text", "id": "signup_title",      "label": "Signup title",       "default": "Get Recipes & Restocking Alerts" },
    { "type": "text", "id": "signup_subtitle",   "label": "Signup subtitle",    "default": "Join our community for exclusive recipes, new product launches, and wholesale news." },
    { "type": "text", "id": "whatsapp_number",   "label": "WhatsApp number",    "default": "447000000000" },
    { "type": "text", "id": "whatsapp_label",    "label": "WhatsApp CTA label", "default": "Join WhatsApp updates" },
    { "type": "text", "id": "whatsapp_prefill",  "label": "WhatsApp pre-filled message", "default": "Hi Crayfield, please add me to your updates list." }
  ],
  "blocks": [
    {
      "name": "Recipe card",
      "type": "recipe",
      "settings": [
        { "type": "image_picker", "id": "image",       "label": "Recipe image" },
        { "type": "text",         "id": "tag",         "label": "Tag",         "default": "Soup" },
        { "type": "text",         "id": "title",       "label": "Title",       "default": "Egusi Soup" },
        { "type": "text",         "id": "description", "label": "Description", "default": "Rich, hearty egusi soup elevated with hand-cleaned ground crayfish." },
        { "type": "url",          "id": "url",         "label": "Recipe URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recipes & Signup",
      "blocks": [
        { "type": "recipe", "settings": { "tag": "Soup",  "title": "Egusi Soup",       "description": "Rich, hearty egusi soup elevated with hand-cleaned ground crayfish." } },
        { "type": "recipe", "settings": { "tag": "Rice",  "title": "Jollof Rice",       "description": "The secret ingredient in every great jollof — a generous pinch of Crayfield crayfish." } },
        { "type": "recipe", "settings": { "tag": "Stew",  "title": "Ogbono Stew",       "description": "Silky ogbono with the depth that only freshly ground crayfish can give." } }
      ]
    }
  ]
}
{% endschema %}
